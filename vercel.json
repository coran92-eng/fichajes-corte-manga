{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/auth-encargado",
      "destination": "/api/auth?rol=encargado"
    },
    {
      "source": "/api/red-local",
      "destination": "/api/fichajes?modulo=red"
    }
  ],
  "crons": [
    {
      "path": "/api/aviso-diario",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
