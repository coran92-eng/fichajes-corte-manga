# Credenciales de Turso (necesarias para la BD)
TURSO_DATABASE_URL=libsql://tu-base-de-datos-turso.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Contraseña de gerencia
ADMIN_PASSWORD=cambia-esto

# Acceso del encargado
ENCARGADO_USER=Albert
ENCARGADO_PASSWORD=cambia-esto

# Secreto con el que se firma el código rotatorio que muestra el iPad del bar.
# Sin él, el fichaje desde el móvil no se habilita y todo sigue como antes.
# Vale cualquier cadena larga y aleatoria; por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_SECRET=

# Avisos por Telegram: una tarea que se pasa de plazo, y un resumen diario de
# lo de ayer (cron en vercel.json). Sin estas dos, no se manda nada — todo
# sigue funcionando igual, simplemente sin avisar.
#
# TELEGRAM_BOT_TOKEN: lo da @BotFather al crear el bot con /newbot.
# TELEGRAM_CHAT_ID: el chat donde debe escribir. Con el bot creado y habiéndole
# mandado ya un mensaje cualquiera, se consulta así:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# y se coge el "chat":{"id": ...} del mensaje.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protege /api/aviso-diario para que solo lo pueda llamar el cron de Vercel.
# Vercel lo manda solo si esta variable existe: basta con ponerla a cualquier
# cadena larga y aleatoria, no hay que configurarla en ningún otro sitio.
CRON_SECRET=
