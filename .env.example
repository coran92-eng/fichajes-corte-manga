# Credenciales de Turso (necesarias para la BD)
TURSO_DATABASE_URL=libsql://tu-base-de-datos-turso.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Contraseña de gerencia
ADMIN_PASSWORD=cambia-esto

# Acceso del encargado
ENCARGADO_USER=Albert
ENCARGADO_PASSWORD=cambia-esto

# Firma las sesiones de encargado/gerencia (api/auth.js). Sin ella, esos dos
# niveles quedan inhabilitados —el login responde 503, no acepta una
# contraseña por defecto—: no hay sesión sin firma real.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Cambiar ADMIN_PASSWORD o ENCARGADO_PASSWORD en cualquier momento invalida al
# instante todas las sesiones de ese nivel que hubiera abiertas —la forma de
# "cerrar todas las sesiones" si hiciera falta.
AUTH_SECRET=

# Secreto con el que se firma el código rotatorio que muestra el iPad del bar.
# Sin él, el fichaje desde el móvil no se habilita y todo sigue como antes.
# Vale cualquier cadena larga y aleatoria; por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_SECRET=

# Avisos por Telegram: una tarea que se pasa de plazo, y un resumen diario de
# lo de ayer (cron en vercel.json). Sin estas dos, no se manda nada — todo
# sigue funcionando igual, simplemente sin avisar.
#
# TELEGRAM_BOT_TOKEN: lo da @BotFather al crear el bot con /newbot.
# TELEGRAM_CHAT_ID: el chat donde debe escribir. Con el bot creado y habiéndole
# mandado ya un mensaje cualquiera, se consulta así:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# y se coge el "chat":{"id": ...} del mensaje.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protege /api/aviso-diario para que solo lo pueda llamar el cron de Vercel.
# Vercel lo manda solo si esta variable existe: basta con ponerla a cualquier
# cadena larga y aleatoria, no hay que configurarla en ningún otro sitio.
CRON_SECRET=

# Protege /api/telegram-webhook (el bot ya no solo avisa, también recibe
# comandos y botones) para que solo lo pueda llamar Telegram. Se la pasas a
# Telegram como "secret_token" al registrar el webhook con setWebhook, y él
# la manda de vuelta en cada petición para que se pueda comprobar. Cualquier
# cadena larga y aleatoria vale, igual que QR_SECRET o CRON_SECRET:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://tu-dominio/api/telegram-webhook&secret_token=<esto>
TELEGRAM_WEBHOOK_SECRET=

# Bot de Telegram para los EMPLEADOS — distinto del de arriba, que es solo
# para gerencia. Cada persona vincula su propio chat con su PIN (el mismo de
# fichar y de las tareas); a partir de ahí puede consultar su horario, sus
# horas y las tareas de hoy, y recibe aviso si le cambian el turno o le
# resuelven una solicitud. Sin estas dos, ese bot simplemente no responde.
#
# Se crea igual que el de gerencia (@BotFather, /newbot) pero como un bot
# NUEVO y separado — no reutilices el mismo token.
TELEGRAM_EMPLEADOS_BOT_TOKEN=
# Mismo criterio que TELEGRAM_WEBHOOK_SECRET, para /api/telegram-empleados:
#   https://api.telegram.org/bot<TOKEN_EMPLEADOS>/setWebhook?url=https://tu-dominio/api/telegram-empleados&secret_token=<esto>
TELEGRAM_EMPLEADOS_WEBHOOK_SECRET=
